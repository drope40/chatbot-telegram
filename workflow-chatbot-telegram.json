      "id": "df7680b9-9738-42cf-9a0e-9cb5e7dcd127",
      "name": "Resposta Válida?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        880,
        300
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Extrai a temperatura do JSON da OpenWeather e monta a mensagem final.\nconst body = $json.body || {};\nconst temperatura = Math.round(Number(body.main.temp));\nconst cidade = body.name;\n\nreturn {\n  json: {\n    cidade,\n    temperatura,\n    message: `🌤️ A temperatura em ${cidade} é de ${temperatura}°C.`,\n    ok: true,\n  },\n};"
      },
      "id": "34c37e60-e808-4d35-951d-238cea43b7c8",
