      "id": "a3482d1d-3694-4d81-880e-3a2cae8b037f",
      "name": "Telegram Trigger",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        300
      ],
      "webhookId": "ccb03442-1bf7-4ed1-bdd8-71b64f14b009"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "9af7955a-e24b-4481-b041-b4709720a3cf",
              "name": "queue",
              "value": "={{ $json.message.text }}",
              "type": "string"
            },
            {
              "id": "18e74964-9220-4800-a953-e331f7e8a8eb",
              "name": "chatId",
              "value": "={{ $json.message.chat.id }}",
              "type": "number"
            }
          ]
        },
        "options": {}
      },
      "id": "11006247-5b15-471d-b0c1-e2486ae0e47c",
      "name": "Capturar Mensagem (queue)",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Normaliza a cidade enviada no Telegram para o formato aceito pela OpenWeather.\n// Ex.: \"  São   Paulo , SP , BR \" -> \"sao paulo,sp,br\"\nreturn $input.all().map((item) => {\n  const original = String(item.json.queue ?? '');\n\n  let queue = original\n    .normalize('NFD')\n    .replace(/[\\u0300-\\u036f]/g, '')   // remove acentos\n    .toLowerCase()                      // letras minúsculas\n    .replace(/[^a-z0-9,'\\- ]/g, ' ')    // remove símbolos estranhos (. ! ? etc.)\n    .replace(/\\s*,\\s*/g, ',')           // remove espaços ao redor das vírgulas\n    .replace(/\\s+/g, ' ')               // colapsa espaços repetidos\n    .replace(/^,+|,+$/g, '')            // remove vírgulas nas pontas\n    .trim();\n\n  // Comandos do Telegram (/start, /help) não são cidades\n  if (original.trim().startsWith('/')) queue = '';\n\n  // Garante o país BR no final (Cidade -> cidade,br | Cidade,UF -> cidade,uf,br)\n  const parts = queue.split(',').map((p) => p.trim()).filter(Boolean);\n  if (parts.length > 0 && parts[parts.length - 1] !== 'br') parts.push('br');\n  queue = parts.join(',');\n\n  return {\n    json: {\n      queue,\n      original,\n      chatId: item.json.chatId,\n    },\n  };\n});"
      },
      "id": "f72c5071-67b8-4dbd-832e-02883e44a83f",
      "name": "Normalizar Cidade",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        300
      ]
    },
    {
      "parameters": {
        "url": "https://api.openweathermap.org/data/2.5/weather",
        "sendQuery": true,
        "queryParameters": {
